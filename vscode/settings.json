{
    // Atruvia Proxy
    "http.proxy": "http://campus-proxy.rz.bankenit.de:8080",
    "http.proxySupport": "on",
    "http.proxyStrictSSL": false,
    "http.proxyAuthorization": null,
    "http.noProxy": [
        "ai-gateway.rz.bankenit.de",
        "ai-gateway-non-prod.rz.bankenit.de",
        // "csainfopenaisdcprodcoda001.openai.azure.com",
        "rz.bankenit.de",
        "fiducia.de"
    ],
    "chat.agentHost.byokModels.enabled": true,
    // Explorer
    "explorer.decorations.colors": true,
    "explorer.decorations.badges": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    // Editor
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.lineNumbers": "relative",
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.mouseWheelZoom": false,
    "editor.fontFamily": "Cascadia Code",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.lightbulb.enabled": "off",
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.scrollbar.horizontal": "hidden",
    "editor.wordWrap": "on",
    "editor.wrappingStrategy": "advanced",
    "editor.tabSize": 4,
    "editor.renderLineHighlight": "none",
    "editor.occurrencesHighlight": "off",
    "editor.hover.enabled": "on",
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    // "files.trimTrailingWhitespace": true,
    // "files.trimFinalNewlines": true,
    // Git
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.decorations.enabled": false,
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": true,
    "git.openRepositoryInParentFolders": "always",
    "git.postCommitCommand": "none",
    "git.enableCommitSigning": false,
    "git.showPushSuccessNotification": true,
    "git.untrackedChanges": "mixed",
    // Window
    "window.title": "${rootName}", // ${activeEditorShort}${separator}${rootName}${separator}${profileName}
    "window.systemColorTheme": "auto",
    "window.autoDetectColorScheme": true,
    // Workbench
    "workbench.tips.enabled": false,
    "workbench.colorTheme": "Light Modern",
    "workbench.preferredDarkColorTheme": "Dark 2026",
    "workbench.editor.enablePreview": false,
    "workbench.statusBar.visible": true,
    // Files
    "files.insertFinalNewline": true,
    "files.autoSave": "afterDelay",
    "files.participants.timeout": 100,
    // Security
    "security.workspace.trust.untrustedFiles": "open",
    // Search
    "search.useIgnoreFiles": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**debug": true,
        "**/package-lock.json": true,
        "**/.next": true,
        "**/data": true
    },
    // Chat / KI
    "chat.editing.confirmEditRequestRemoval": false,
    "chat.agentsControl.enabled": "hidden",
    "chat.viewSessions.orientation": "stacked",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.disableAIFeatures": true,
    // Terminal
    "terminal.integrated.initialHint": false,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.copyOnSelection": false,
    "terminal.integrated.confirmOnExit": "never",
    "terminal.integrated.enableMultiLinePasteWarning": "auto",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.osx": "zsh",
    // Vim
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.insertModeKeyBindings": [
        { "before": [ "k", "j" ], "after": [ "<Esc>" ] },
        { "before": [ "j", "k" ], "after": [ "<Esc>" ] }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": [ "H" ], "after": [ "0" ] },
        { "before": [ "L" ], "after": [ "$" ] }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": [ "H" ], "after": [ "0" ] },
        { "before": [ "L" ], "after": [ "$" ] }
    ],
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false,
        "<C-p>": false,
        "<C-S-p>": false,
        "<C-j>": false,
        "<C-w>": false,
        "<C-r>": false
    },
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    // Misc.
    "update.mode": "none",
    "diffEditor.ignoreTrimWhitespace": false,
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true
    },
    "debug.onTaskErrors": "showErrors",
    "extensions.ignoreRecommendations": true,
    "workbench.preferredLightColorTheme": "Dark 2026",
    "breadcrumbs.enabled": true,
}
